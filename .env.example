# =============================================================================
# COREFLOW — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo como `.env.local` y configura las credenciales de tu
# proyecto de Supabase. NUNCA subas `.env` ni `.env.local` a GitHub.
# NUNCA expongas `SUPABASE_SERVICE_ROLE_KEY` con el prefijo `VITE_`.
# =============================================================================

# 1. Variables públicas para el cliente Web (Vite) — Protegidas por Row Level Security (RLS)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key_aqui

# 2. Variables exclusivas para el script CLI de aprovisionamiento inicial (`scripts/provision-coreflow-accounts.mjs`)
# IMPORTANTE: Estas variables solo son leídas por Node.js en terminal administrativa, nunca por el navegador.
SUPABASE_SERVICE_ROLE_KEY=
PROVISION_PLATFORM_ADMIN_EMAIL=
PROVISION_PLATFORM_ADMIN_PASSWORD=
PROVISION_STARTER_ADMIN_EMAIL=
PROVISION_STARTER_ADMIN_PASSWORD=
PROVISION_BUSINESS_ADMIN_EMAIL=
PROVISION_BUSINESS_ADMIN_PASSWORD=
