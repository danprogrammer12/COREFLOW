# =============================================================================
# COREFLOW — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo como `.env.local` y configura las credenciales de tu
# proyecto de Supabase. NUNCA subas `.env` ni `.env.local` a GitHub.
# NUNCA expongas `SUPABASE_SERVICE_ROLE_KEY` con el prefijo `VITE_`.
# =============================================================================

# 0. Modo de datos: local-dev o supabase-prod. No hay fallback: si se pide
# supabase-prod y falta configuración, la aplicación falla de forma visible.
VITE_COREFLOW_DATA_MODE=local-dev
# Registro de consentimiento en el servidor. Requiere aplicar supabase/proposed/018. Valores: off | on
VITE_COREFLOW_PRIVACY_SYNC=off

# 1. Variables públicas para el cliente Web (Vite) — Protegidas por Row Level Security (RLS)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key_aqui

# 2. Variables exclusivas para el script CLI de aprovisionamiento inicial (`scripts/provision-coreflow-accounts.mjs`)
# IMPORTANTE: Estas variables solo son leídas por Node.js en terminal administrativa, nunca por el navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
PROVISION_PLATFORM_ADMIN_EMAIL=
PROVISION_PLATFORM_ADMIN_PASSWORD=
PROVISION_STARTER_ADMIN_EMAIL=
PROVISION_STARTER_ADMIN_PASSWORD=
PROVISION_BUSINESS_ADMIN_EMAIL=
PROVISION_BUSINESS_ADMIN_PASSWORD=

# 3. Destino del aprovisionamiento. Solo se admite un proyecto de desarrollo.
COREFLOW_TARGET_ENV=development
COREFLOW_SUPABASE_PROJECT_REF=

# 4. Organizaciones iniciales. Sin datos inventados: se definen aquí.
PROVISION_STARTER_ORG_SLUG=
PROVISION_STARTER_ORG_NAME=
PROVISION_STARTER_ORG_LEGAL_NAME=
PROVISION_STARTER_ORG_TAX_ID=
PROVISION_STARTER_ORG_SECTOR=
PROVISION_BUSINESS_ORG_SLUG=
PROVISION_BUSINESS_ORG_NAME=
PROVISION_BUSINESS_ORG_LEGAL_NAME=
PROVISION_BUSINESS_ORG_TAX_ID=
PROVISION_BUSINESS_ORG_SECTOR=

# 5. Pruebas contra Supabase real. Dejar vacío salvo autorización explícita.
COREFLOW_SUPABASE_E2E=
